# 服务端口
PORT=3000

# MySQL 连接串（本文件为示例，实际配置写入 .env，.env 不入库）
DATABASE_URL="mysql://root:123456@localhost:3306/medical_assistant"

# ChromaDB 服务地址
CHROMA_URL="http://localhost:8000"

# 对话与结构化输出模型（OpenAI 兼容端点）
LLM_BASE_URL="https://api.deepseek.com"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"

# Embedding 模型（OpenAI 兼容端点）
EMBEDDING_BASE_URL="https://api.siliconflow.cn/v1"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="BAAI/bge-m3"

# JWT 密钥与有效期
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# 默认医院 ID（种子数据中的默认医院）
DEFAULT_HOSPITAL_ID="1"

# 待支付订单超时分钟数
APPOINTMENT_EXPIRE_MINUTES="15"
