# 服务端口
PORT=3000

# MySQL 连接串（数据库部署在 192.168.145.101，密码填实际值）
DATABASE_URL="mysql://root:password@192.168.145.101:3306/medical_assistant"

# ChromaDB 服务地址（部署在 192.168.145.101）
CHROMA_URL="http://192.168.145.101:8000"

# 对话与结构化输出模型（OpenAI 兼容端点）
LLM_BASE_URL="https://api.deepseek.com"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"

# 单次对话请求超时（毫秒）
LLM_TIMEOUT_MS=60000

# Embedding 模型（本地加载）
EMBEDDING_MODEL="BAAI/bge-m3"

# 模型下载目录
EMBEDDING_MODEL_DIR="./models"

# 向量计算批大小
EMBEDDING_BATCH_SIZE=8

# JWT 密钥与有效期
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# 默认医院 ID（种子数据中的默认医院）
DEFAULT_HOSPITAL_ID="1"

# 待支付订单超时分钟数
APPOINTMENT_EXPIRE_MINUTES="15"
